// Astroid API — Prisma schema
// The historical record of every financial decision made by autonomous AI agents.
// Multi-tenant by design: every major entity belongs to an Organization.
// Timestamps are UTC (timestamptz). Soft deletes via deletedAt where applicable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrganizationPlan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserRole {
  OWNER
  ADMIN
  FINANCE
  DEVELOPER
  AUDITOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  ARCHIVED
}

enum AgentRole {
  FINANCE
  RESEARCH
  OPERATIONS
  PROCUREMENT
  CUSTOM
}

enum AgentStatus {
  ACTIVE
  PAUSED
  SUSPENDED
  ARCHIVED
}

enum WalletType {
  AGENT
  TREASURY
  ESCROW
  SHARED
  PERSONAL
}

enum WalletStatus {
  ACTIVE
  FROZEN
  PAUSED
  ARCHIVED
}

enum StellarNetwork {
  TESTNET
  PUBLIC
  FUTURENET
}

enum PolicyType {
  MAX_AMOUNT
  MIN_AMOUNT
  ALLOWED_ASSETS
  BLOCKED_ASSETS
  DAILY_BUDGET
  WEEKLY_BUDGET
  MONTHLY_BUDGET
  ALLOWED_RECIPIENTS
  BLOCKED_RECIPIENTS
  TIME_WINDOW
  DEPARTMENT_RULE
  AGENT_RULE
  EMERGENCY_LOCK
  COMPOSITE
}

enum BudgetPeriod {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

// Carry-over applied when a budget period is closed by the scheduled rollover.
// NONE is the default so existing budgets keep their reset-to-zero behaviour.
enum BudgetCarryOverRule {
  NONE
  UNUSED
  OVERSPEND
  NET
}

enum BudgetPeriodStatus {
  OPEN
  CLOSED
}

enum TransactionStatus {
  DRAFT
  PENDING
  APPROVED
  SUBMITTED
  CONFIRMED
  COMPLETED
  REJECTED
  EXPIRED
  CANCELLED
  FAILED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProposalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
  CANCELLED
}

enum ApprovalType {
  SINGLE
  DUAL
  MULTISIG
  ROLE
  COMMITTEE
  EMERGENCY
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  DELEGATED
  EXPIRED
}

enum NotificationType {
  BUDGET_EXCEEDED
  PROPOSAL_APPROVED
  PROPOSAL_REJECTED
  WALLET_FUNDED
  PAYMENT_FAILED
  POLICY_VIOLATION
  RISK_ALERT
  APPROVAL_REQUIRED
  INFO
}

enum NotificationChannel {
  DASHBOARD
  EMAIL
  DISCORD
  SLACK
  WEBHOOK
}

// ---------------------------------------------------------------------------
// 1. Organization
// ---------------------------------------------------------------------------

model Organization {
  id          String             @id @default(uuid(7))
  name        String
  slug        String             @unique
  logo        String?
  description String?
  plan        OrganizationPlan   @default(FREE)
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  users                User[]
  agents               Agent[]
  wallets              Wallet[]
  policies             Policy[]
  budgets              Budget[]
  budgetPeriodRecords  BudgetPeriodRecord[]
  budgetReservations   BudgetReservation[]
  transactions         Transaction[]
  auditLogs            AuditLog[]
  apiKeys              ApiKey[]
  webhooks             Webhook[]
  webhookDeliveries    WebhookDelivery[]
  budgetAlerts         BudgetAlert[]
  webhookCircuitStates WebhookCircuitState[]
  notifications        Notification[]
  memoryRecords        MemoryRecord[]
  domainEvents         DomainEvent[]
  riskAssessments      RiskAssessment[]

  @@index([status])
  @@index([createdAt])
  @@map("organizations")
}

// ---------------------------------------------------------------------------
// 2. User
// ---------------------------------------------------------------------------

model User {
  id             String     @id @default(uuid(7))
  organizationId String
  name           String
  email          String     @unique
  avatar         String?
  passwordHash   String?
  role           UserRole   @default(VIEWER)
  status         UserStatus @default(ACTIVE)
  lastLogin      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions      Session[]
  approvals     Approval[]
  notifications Notification[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]
  credentials         PasskeyCredential[]
  passkeyChallenges   PasskeyChallenge[]

  @@index([organizationId])
  @@index([status])
  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
  @@map("users")
}

// ---------------------------------------------------------------------------
// 3. Agent
// ---------------------------------------------------------------------------

model Agent {
  id              String      @id @default(uuid(7))
  organizationId  String
  primaryWalletId String?     @unique
  name            String
  description     String?
  provider        String?
  model           String?
  role            AgentRole   @default(CUSTOM)
  status          AgentStatus @default(ACTIVE)
  capabilities    String[]    @default([])
  metadata        Json        @default("{}")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primaryWallet Wallet?        @relation("AgentPrimaryWallet", fields: [primaryWalletId], references: [id])
  wallets       Wallet[]       @relation("WalletOwnerAgent")
  policies      Policy[]
  budgets       Budget[]
  transactions  Transaction[]
  memoryRecords MemoryRecord[]

  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status])
  @@index([organizationId, status, createdAt])
  @@map("agents")
}

// ---------------------------------------------------------------------------
// 4. Wallet
// ---------------------------------------------------------------------------

model Wallet {
  id             String         @id @default(uuid(7))
  organizationId String
  agentId        String?
  stellarAddress String         @unique
  label          String?
  walletType     WalletType     @default(AGENT)
  network        StellarNetwork @default(TESTNET)
  status         WalletStatus   @default(ACTIVE)
  /// Last reconciled native (XLM) balance snapshot. Null until the first
  /// successful reconciliation; never overwritten by a failed fetch.
  balance        Decimal?       @db.Decimal(20, 7)
  /// When `balance` was last successfully reconciled against Horizon.
  lastSyncedAt   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent           Agent?        @relation("WalletOwnerAgent", fields: [agentId], references: [id])
  primaryForAgent Agent?        @relation("AgentPrimaryWallet")
  transactions    Transaction[]

  @@index([organizationId])
  @@index([agentId])
  @@index([status])
  @@index([stellarAddress])
  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
  @@map("wallets")
}

// ---------------------------------------------------------------------------
// 5. Policy  (JSONB configuration supports many policy types w/o schema change)
// ---------------------------------------------------------------------------

model Policy {
  id             String     @id @default(uuid(7))
  organizationId String
  agentId        String?
  name           String
  description    String?
  type           PolicyType
  configuration  Json       @default("{}")
  priority       Int        @default(100)
  enabled        Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  // Temporary spending override (issue #21). While overrideUntil is in the
  // future the max-amount check uses overrideLimit; on expiry it falls back to
  // originalLimit (or the configured maxAmount). The cleanup job clears these.
  overrideLimit Decimal?    @db.Decimal(30, 7)
  overrideUntil DateTime?
  originalLimit Decimal?    @db.Decimal(30, 7)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent?        @relation(fields: [agentId], references: [id])
  transactions Transaction[]

  @@index([organizationId])
  @@index([agentId])
  @@index([enabled])
  @@index([organizationId, enabled])
  @@index([overrideUntil])
  @@map("policies")
}

// ---------------------------------------------------------------------------
// 6. Budget  (hierarchy: Organization -> Department -> Project -> Agent)
// ---------------------------------------------------------------------------

model Budget {
  id             String       @id @default(uuid(7))
  organizationId String
  parentBudgetId String?
  agentId        String?
  name           String
  currency       String       @default("USDC")
  limitAmount    Decimal      @default(0) @db.Decimal(30, 7)
  spent          Decimal      @default(0) @db.Decimal(30, 7)
  period         BudgetPeriod @default(MONTHLY)
  periodStart    DateTime     @default(now())
  // End of the current fixed period; null for ONE_TIME budgets.
  periodEnd      DateTime?
  // Immutable first period anchor: month-end clamping is always relative to it.
  periodAnchor   DateTime?
  // Number of completed periods since periodAnchor.
  periodIndex    Int          @default(0)
  // IANA timezone used for period boundaries (e.g. Africa/Lagos).
  timezone       String       @default("UTC")
  // Amount transferred into the next period when one elapses.
  carryOverRule  BudgetCarryOverRule @default(NONE)
  rollover       Boolean      @default(false)
  enabled        Boolean      @default(true)
  // Per-budget override of the percentage thresholds that emit budget alerts.
  // Empty means "use the global defaults" (BUDGET_ALERT_THRESHOLDS).
  alertThresholds Int[]       @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentBudget Budget?       @relation("BudgetHierarchy", fields: [parentBudgetId], references: [id])
  children     Budget[]      @relation("BudgetHierarchy")
  agent        Agent?        @relation(fields: [agentId], references: [id])
  transactions Transaction[]
  budgetAlerts BudgetAlert[]
  periodRecords BudgetPeriodRecord[]
  reservations BudgetReservation[]

  @@index([organizationId])
  @@index([parentBudgetId])
  @@index([agentId])
  @@index([organizationId, createdAt])
  @@map("budgets")
}

// Immutable history of a budget's fixed periods. The unique (budgetId,
// periodStart) key makes the scheduled rollover idempotent, while the CLOSED
// rows keep the final spend snapshot needed for audits and carry-over.
model BudgetPeriodRecord {
  id             String              @id @default(uuid(7))
  budgetId       String
  organizationId String
  periodStart    DateTime
  periodEnd      DateTime
  status         BudgetPeriodStatus  @default(OPEN)
  // Spend captured when the period was closed; null while still open.
  finalSpent     Decimal?            @db.Decimal(30, 7)
  // Amount carried into this period by its opening rollover.
  openingBalance Decimal             @default(0) @db.Decimal(30, 7)
  carryOverRule  BudgetCarryOverRule @default(NONE)
  closedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  budget       Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([budgetId, periodStart])
  @@index([organizationId, periodEnd])
  @@index([status, periodEnd])
  @@map("budget_periods")
}

// ---------------------------------------------------------------------------
// 7. Transaction
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// 6b. Budget reservation
// ---------------------------------------------------------------------------

// Lifecycle of an atomic budget reservation.
enum ReservationStatus {
  PENDING   // Amount is held; transaction not yet settled.
  SETTLED   // Transaction completed; spent adjusted to actual amount.
  RELEASED  // Transaction failed or cancelled; held amount returned.
}

// An atomic hold on a portion of a budget's remaining balance. The reservation
// is created before the transaction executes, so concurrent requests cannot
// both observe the same remaining headroom. Settlement adjusts the held amount
// to the actual amount; release returns it in full.
model BudgetReservation {
  id             String            @id @default(uuid(7))
  budgetId       String
  organizationId String
  amount         Decimal           @db.Decimal(30, 7)
  settledAmount  Decimal?          @db.Decimal(30, 7)
  status         ReservationStatus @default(PENDING)
  // Start of the budget period the hold was taken in. Settling or releasing
  // only adjusts `spent` while the budget is still in that period; after a
  // rollover the hold belongs to the closed period's snapshot and the new
  // period's spend is never touched. Null for holds created before this column.
  periodStart    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  budget       Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([budgetId, status])
  @@index([organizationId, createdAt])
  @@map("budget_reservations")
}

// ---------------------------------------------------------------------------
// 7. Transaction
// ---------------------------------------------------------------------------

model Transaction {
  id                String            @id @default(uuid(7))
  organizationId    String
  walletId          String
  agentId           String?
  policyId          String?
  budgetId          String?
  // Tracks the atomic budget reservation that guarded this transaction.
  budgetReservationId String?
  asset             String            @default("XLM")
  amount            Decimal           @db.Decimal(30, 7)
  senderAddress     String?
  recipientAddress  String
  memo              String?
  purpose           String?
  status            TransactionStatus @default(DRAFT)
  riskScore         Int               @default(0)
  riskBand          RiskBand          @default(LOW)
  requiresApproval  Boolean           @default(false)
  stellarHash       String?
  confirmationCount Int               @default(0)
  gasEstimate       Decimal?          @db.Decimal(30, 7)
  simulatedAt       DateTime?
  minResourceFee    Decimal?          @db.Decimal(30, 0)
  footprintSummary  Json?
  simulationErrorCode    String?
  simulationErrorMessage String?
  metadata          Json              @default("{}")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wallet        Wallet         @relation(fields: [walletId], references: [id])
  agent         Agent?         @relation(fields: [agentId], references: [id])
  policy        Policy?        @relation(fields: [policyId], references: [id])
  budget        Budget?        @relation(fields: [budgetId], references: [id])
  budgetReservation BudgetReservation? @relation(fields: [budgetReservationId], references: [id])
  proposal      Proposal?
  memoryRecords MemoryRecord[]

  @@index([organizationId])
  @@index([walletId])
  @@index([agentId])
  @@index([organizationId, status, deletedAt, agentId])
  @@index([status])
  @@index([createdAt])
  @@index([stellarHash])
  @@index([riskScore])
  @@index([organizationId, createdAt])
  @@index([walletId, status])
  @@index([agentId, status])
  @@index([agentId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([agentId, status, createdAt])
  @@index([budgetReservationId])
  @@map("transactions")
}

model TransactionIdempotencyRecord {
  id             String            @id @default(uuid(7))
  principalId    String
  /// Legacy operation name. Always mirrors `route` for rows written since
  /// route scoping was introduced; kept so older rows remain readable.
  operation      String
  /// Route the key is scoped to, e.g. `POST /transactions`.
  route          String            @default("transactions.create")
  keyHash        String
  requestHash    String
  status         IdempotencyStatus @default(PROCESSING)
  transactionId  String?
  response       Json?
  /// HTTP status the cached response must be replayed with.
  responseStatus Int?
  /// Request id of the original request, replayed on a cached response.
  requestId      String?
  createdAt      DateTime          @default(now())
  completedAt    DateTime?
  expiresAt      DateTime

  @@unique([principalId, route, keyHash])
  @@index([expiresAt])
  @@map("transaction_idempotency_records")
}

// Durable, reusable Idempotency-Key record for mutating HTTP endpoints. Keys are
// scoped by authenticated principal and route; the Redis lock is only the
// short-lived in-progress guard, this row is the replayable source of truth.
model IdempotencyRecord {
  id             String            @id @default(uuid(7))
  principalId    String
  // Credential namespace the key belongs to, e.g. "user:<id>" or "apikey:<id>".
  // Included in the unique constraint so different credentials may reuse a key.
  scope          String            @default("")
  // Normalised route identity, e.g. "POST /api/v1/transactions".
  route          String
  keyHash        String
  requestHash    String
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?
  // Request id of the original execution, replayed to the caller.
  requestId      String?
  // Set when the reserved work is a transaction, so async workers can finalize
  // (or fail) the record once its terminal result is known.
  transactionId  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  expiresAt      DateTime

  @@unique([scope, route, keyHash])
  @@index([expiresAt])
  @@index([transactionId])
  @@map("idempotency_records")
}

// Ledger of budget-threshold alerts already emitted for one budget period.
// The unique constraint makes threshold evaluation idempotent: a spend that
// crosses 80% twice in the same period emits the alert exactly once. A new
// period produces new rows, which resets the tracking automatically.
model BudgetAlert {
  id             String    @id @default(uuid(7))
  budgetId       String
  organizationId String
  periodStart    DateTime
  // Percentage of the limit that was crossed (80, 100, or a configured value).
  threshold      Int
  currency       String
  usageAmount    Decimal   @db.Decimal(30, 7)
  // Set once the notification consumer has created the notification records.
  notifiedAt     DateTime?
  createdAt      DateTime  @default(now())

  budget       Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([budgetId, periodStart, threshold])
  @@index([organizationId, createdAt])
  @@map("budget_alerts")
}

// ---------------------------------------------------------------------------
// 8. Proposal
// ---------------------------------------------------------------------------

model Proposal {
  id             String         @id @default(uuid(7))
  organizationId String
  transactionId  String         @unique
  title          String
  description    String?
  approvalType   ApprovalType   @default(SINGLE)
  requiredApprovals Int         @default(1)
  status         ProposalStatus @default(PENDING)
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  approvals   Approval[]

  @@index([organizationId])
  @@index([status])
  @@index([transactionId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([status, expiresAt])
  @@map("proposals")
}

// ---------------------------------------------------------------------------
// 9. Approval
// ---------------------------------------------------------------------------

model Approval {
  id         String           @id @default(uuid(7))
  proposalId String
  userId     String
  decision   ApprovalDecision
  comment    String?
  expiresAt  DateTime?
  createdAt  DateTime         @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([proposalId])
  @@index([userId])
  @@index([createdAt])
  @@index([expiresAt])
  @@unique([proposalId, userId])
  @@map("approvals")
}

// ---------------------------------------------------------------------------
// 10. Audit Log  (append-only from the application perspective)
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid(7))
  organizationId String
  userId         String?
  action         String
  entity         String
  entityId       String?
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  device         String?
  // Correlates this entry with the originating request's trace id
  // (AsyncLocalStorage-backed `TraceContext`, seeded from `x-request-id` /
  // `x-correlation-id`). Not part of the hash chain — it's correlation
  // metadata, not tamper-evident content.
  requestId      String?
  // Derived result of the audited operation (SUCCESS / FAILURE), stored as a
  // first-class column so clients can filter on it without scanning JSON.
  outcome        String?
  sourceEventId  String?  @unique
  prevHash       String?  // Previous organization-scoped audit-chain hash; GENESIS starts a new chain
  hash           String?  // SHA-256 hash of this entry (links to previous)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, entity, entityId, createdAt, id])
  @@index([organizationId, userId, createdAt, id])
  @@index([organizationId, action, createdAt, id])
  @@index([organizationId, entity, createdAt, id])
  @@index([organizationId, outcome, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// 11. Notification
// ---------------------------------------------------------------------------

model Notification {
  id             String              @id @default(uuid(7))
  organizationId String
  userId         String
  title          String
  body           String
  type           NotificationType    @default(INFO)
  channel        NotificationChannel @default(DASHBOARD)
  read           Boolean             @default(false)
  metadata       Json                @default("{}")
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([organizationId, userId, read, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// 12. API Key  (never store raw keys — only hashes)
// ---------------------------------------------------------------------------

model ApiKey {
  id             String    @id @default(uuid(7))
  organizationId String
  createdById    String?
  name           String
  prefix         String
  lastFour       String?
  status         String    @default("active")
  hashedKey      String    @unique
  permissions    String[]  @default([])
  scopes         String[]  @default(["read"])
  allowedIps     String[]  @default([])
  // Per-key overrides for the credential rate limiter. Null keeps the
  // configured default tier limit.
  rateLimitPerMinute Int?
  rateLimitPerDay    Int?
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  rotatedAt      DateTime?
  previousKeyExpiresAt DateTime?
  replacementId  String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([prefix])
  @@map("api_keys")
}

enum WebhookDeliveryStatus {
  PENDING
  RETRYING
  FAILED
  DELIVERED
}

// ---------------------------------------------------------------------------
// 13. Webhook  (HMAC secret; dot.case event subscriptions)
// ---------------------------------------------------------------------------

model Webhook {
  id             String   @id @default(uuid(7))
  organizationId String
  url            String
  secret         String
  events         String[] @default([])
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries       WebhookDelivery[]
  deliveryAttempts WebhookDeliveryAttempt[]
  circuitState     WebhookCircuitState?

  @@index([organizationId])
  @@index([enabled])
  @@map("webhooks")
}

model WebhookDelivery {
  id              String                @id @default(uuid(7))
  webhookId       String
  organizationId  String
  eventName       String
  eventId         String
  payload         Json                  @default("{}")
  status          WebhookDeliveryStatus @default(PENDING)
  attempts        Int                   @default(0)
  lastError       String?
  responseStatus  Int?
  // Structured failure metadata for the most recent failed attempt:
  //   failureCategory — broad class of the failure (transient, permanent,
  //                     timeout or circuit-open)
  //   failureCode     — machine-readable reason (HTTP_503, TIMEOUT, …)
  failureCategory String?
  failureCode     String?
  // When the last attempt was made and when the next one is scheduled.
  lastAttemptAt   DateTime?
  nextRetryAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  webhook      Webhook      @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([organizationId])
  @@index([status])
  @@index([eventId])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

// One row per delivery attempt (initial + every retry). Kept separately from
// WebhookDelivery, which holds the current state of a delivery: this table is
// the append-only attempt history an operator needs to explain a failure.
model WebhookDeliveryAttempt {
  id             String   @id @default(uuid(7))
  webhookId      String
  organizationId String
  eventId        String
  // 1-based index of the attempt within the delivery.
  attemptNumber  Int
  // SUCCEEDED or FAILED.
  status         String
  responseStatus Int?
  // Wall-clock duration of the HTTP request, in milliseconds.
  durationMs     Int
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([organizationId])
  @@index([eventId])
  @@index([createdAt])
  @@map("webhook_delivery_attempts")
}

// State of the per-endpoint circuit breaker. One row per webhook endpoint so
// the failure history survives a worker restart and is shared by every worker
// of a multi-instance deployment.
enum WebhookCircuitStatus {
  CLOSED
  OPEN
  HALF_OPEN
}

model WebhookCircuitState {
  // The webhook endpoint this circuit protects.
  webhookId           String               @id
  organizationId      String
  status              WebhookCircuitStatus @default(CLOSED)
  // Failed attempts since the last successful delivery.
  consecutiveFailures Int                  @default(0)
  // Failed attempts over the lifetime of the endpoint.
  totalFailures       Int                  @default(0)
  // When the circuit was opened and when the cooldown ends.
  openedAt            DateTime?
  cooldownEndsAt      DateTime?
  // The most recent failure, for operator diagnostics.
  lastFailureAt       DateTime?
  lastFailureCode     String?
  lastFailureReason   String?
  // The most recent successful delivery.
  lastSuccessAt       DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  webhook      Webhook      @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@map("webhook_circuit_states")
}

// ---------------------------------------------------------------------------
// 14. Session
// ---------------------------------------------------------------------------

model Session {
  id                String    @id @default(uuid(7))
  userId            String
  device            String?
  browser           String?
  ipAddress         String?
  location          String?
  refreshTokenHash  String    @unique
  // Token-family reuse detection (refresh-token rotation).
  //
  // `familyId` persists across rotations: every session minted during a
  // rotation inherits the family of the session it replaces, so presenting
  // any token of the family revokes them all on reuse.
  //
  // `consumedAt` is set atomically when the refresh token is rotated
  // (conditional update), so a replayed token is detectable.
  //
  // `replacedByTokenId` records, on the replaced session, the id of the
  // session that replaced it.
  familyId          String
  consumedAt        DateTime?
  replacedByTokenId String?
  lastActivityAt    DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// 15. Memory Record  (financial memory — powers explainability & search)
// ---------------------------------------------------------------------------

model MemoryRecord {
  id             String   @id @default(uuid(7))
  organizationId String
  agentId        String?
  transactionId  String?
  task           String?
  reason         String?
  conversationId String?
  policyUsed     String?
  risk           Int?
  summary        String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent?       @relation(fields: [agentId], references: [id])
  transaction  Transaction? @relation(fields: [transactionId], references: [id])

  @@index([organizationId])
  @@index([agentId])
  @@index([transactionId])
  @@index([conversationId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([agentId, createdAt])
  @@map("memory_records")
}

// ---------------------------------------------------------------------------
// Passkey credential (WebAuthn-ready scaffold)
// ---------------------------------------------------------------------------

model PasskeyCredential {
  id           String   @id @default(uuid(7))
  userId       String
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  deviceName   String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

// ---------------------------------------------------------------------------
// Passkey challenge  (temporary storage for WebAuthn registration ceremonies)
// ---------------------------------------------------------------------------

model PasskeyChallenge {
  id        String   @id @default(uuid(7))
  userId    String
  challenge String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("passkey_challenges")
}

// ---------------------------------------------------------------------------
// Domain Event  (append-only event-sourcing / immutable event ledger)
// ---------------------------------------------------------------------------

model DomainEvent {
  id             String   @id @default(uuid(7))
  organizationId String?
  name           String
  aggregateType  String
  aggregateId    String?
  payload        Json     @default("{}")
  actorId        String?
  sequence       BigInt   @default(autoincrement())
  occurredAt     DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([name])
  @@index([aggregateType, aggregateId])
  @@index([occurredAt])
  @@map("domain_events")
}

// ---------------------------------------------------------------------------
// Transactional Outbox Event
// ---------------------------------------------------------------------------

model OutboxEvent {
  id          String    @id @default(uuid(7))
  eventType   String
  payload     Json
  status      String    @default("PENDING") // PENDING, COMPLETED, FAILED
  retryCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?
  error       String?

  @@index([status, createdAt])
  @@map("outbox_events")
}

model CleanupJobLog {
  id             String   @id @default(uuid(7))
  organizationId String?
  jobName        String
  recordsDeleted Int
  durationMs     Int
  status         String
  error          String?
  createdAt      DateTime @default(now())

  @@index([jobName, createdAt])
  @@map("cleanup_job_logs")
}

// ---------------------------------------------------------------------------
// Audit Log Archive  (compressed cold storage for expired audit rows)
// ---------------------------------------------------------------------------

// Audit rows that left the actively queried `audit_logs` table. The rows are
// stored as one gzip-compressed JSON document per batch, together with a
// checksum and the hash-chain anchor of the batch, so the audit history is
// preserved while the hot table stays small.
model AuditLogArchive {
  id             String   @id @default(uuid(7))
  // Deterministic id of the batch (derived from the archived row ids) so a
  // retried run reuses the same archive instead of creating a duplicate.
  batchId        String   @unique
  organizationId String
  // Retention cutoff that selected the batch.
  cutoff         DateTime
  // Number of audit rows stored in this archive.
  recordCount    Int
  // gzip-compressed JSON array with the archived rows.
  payload        Bytes
  // SHA-256 of the uncompressed payload.
  checksum       String
  // Hash of the last archived entry: the chain anchor of the live rows.
  chainBoundaryHash String?
  // createdAt of the newest archived row.
  archivedThrough   DateTime
  createdAt      DateTime @default(now())

  @@index([organizationId, archivedThrough])
  @@index([createdAt])
  @@map("audit_log_archives")
}

// ---------------------------------------------------------------------------
// Risk Assessment  (historical risk scoring for compliance and analytics)
// ---------------------------------------------------------------------------

model RiskAssessment {
  id             String   @id @default(uuid(7))
  organizationId String
  transactionId  String   @unique
  score          Int
  band           RiskBand
  factors        Json     @default("{}")
  canAutoExecute Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([score])
  @@index([band])
  @@index([createdAt])
  @@map("risk_assessments")
}
